---
import Site from '../layouts/Site.astro';
import KleapForm from '@/components/KleapForm';
const source={name:'source',label:'Source',type:'hidden' as const,param:'utm'};
---
<Site title="Contact & Volunteer | Lifeline Development Trust Odisha" description="Contact Lifeline Development Trust in Sorada, Odisha to volunteer, discuss a partnership or enquire about supporting its charitable objectives."><main><section class="page-top"><div class="wrap"><p class="breadcrumbs"><a href="/">Home</a> / Contact Us</p><p class="eyebrow">LET’S CONNECT</p><h1>Good things begin<br/>with a conversation.</h1><p class="lead">Volunteer your time, explore a partnership, or tell us how you would like to support LIFELINE DEVELOPMENT TRUST.</p></div></section><section class="wrap section contact-grid"><aside class="contact-info"><p class="eyebrow">OUR REGISTERED OFFICE</p><h2>Rooted in Sorada.<br/>Open to you.</h2><p><strong>LIFELINE DEVELOPMENT TRUST</strong><br/>Sorada, Ganjam,<br/>Odisha, India.</p><p>Use the enquiry forms to reach the Trust. Only verified telephone numbers, email addresses and social profiles will be published.</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Sorada%2C%20Ganjam%2C%20Odisha%2C%20India" target="_blank" rel="noopener noreferrer">View Sorada on Google Maps ↗</a><p class="legal-disclosure">Map shows the Sorada locality, not a verified office building.</p><div class="value-row"><a class="value-chip" href="#volunteer">Volunteer enquiry ↓</a><a class="value-chip" href="#donate">Donation enquiry ↓</a></div></aside><div id="contact-form" class="contact-form"><KleapForm client:load formId="contact" title="Send us a message" description="We welcome your questions and ideas." fields={[{name:'name',label:'Name',type:'text',required:true},{name:'email',label:'Email',type:'email',required:true},{name:'phone',label:'Phone',type:'phone',defaultCountry:'IN'},{name:'subject',label:'Subject',type:'text',required:true},{name:'message',label:'Message',type:'textarea',required:true},source]} submitText="Send Message" successMessage="Thank you. Your message has been received by Lifeline Development Trust."/><p class="legal-disclosure">By sending this message you agree that the Trust may use these details to respond to your enquiry. <a href="/privacy">Read our privacy notice.</a></p></div></section><section class="aqua-section"><div class="wrap section"><div class="section-heading"><div><p class="eyebrow">GIVE SOMETHING MEANINGFUL</p><h2>Your time. Your skills. Your care.</h2></div></div><div class="form-pair"><div id="volunteer" class="contact-form"><KleapForm client:load formId="volunteer" title="Become a volunteer" description="Register your interest. This is an enquiry, not a confirmed placement." fields={[{name:'name',label:'Full name',type:'text',required:true},{name:'email',label:'Email',type:'email',required:true},{name:'phone',label:'Phone',type:'phone',defaultCountry:'IN'},{name:'interest',label:'Area of interest',type:'select',required:true,options:['Education','Healthcare','Community Support','Food and Shelter','Skills and Training','Social Welfare and Culture','Environment']},{name:'availability',label:'Availability',type:'text',required:true},{name:'message',label:'Skills and motivation',type:'textarea',required:true},source]} submitText="Register Volunteer Interest" successMessage="Thank you. Your volunteer interest has been received. The Trust will contact you about suitable opportunities."/></div><div id="donate" class="contact-form"><KleapForm client:load formId="donation-enquiry" title="Enquire about donating" description="Discuss supporting our charitable objectives. No payments are collected on this website." fields={[{name:'name',label:'Full name',type:'text',required:true},{name:'email',label:'Email',type:'email',required:true},{name:'support',label:'How would you like to help?',type:'select',required:true,options:['Discuss a financial contribution','Offer materials or resources','Explore an organizational partnership']},{name:'message',label:'Your enquiry',type:'textarea',required:true},source]} submitText="Send Donation Enquiry" successMessage="Thank you. Your donation enquiry has been received. No payment has been taken."/><p class="legal-disclosure">No tax exemption, deduction eligibility or donation certification is claimed. Please request verified details from the Trust before contributing.</p></div></div></div></section><section class="wrap section"><p class="eyebrow">FIND OUR LOCALITY</p><h2>Sorada, Ganjam, Odisha.</h2><iframe class="map-frame" title="Map of Sorada locality, Ganjam, Odisha, India" src="https://maps.google.com/maps?q=Sorada%2C%20Ganjam%2C%20Odisha%2C%20India&t=&z=12&ie=UTF8&iwloc=&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><p class="disclosure">Location view is approximate; an exact office pin has not been supplied.</p><div style="margin-top:35px"><h3>Connect on social media</h3><p>Verified social media profiles have not yet been supplied. Please use our contact form rather than unofficial accounts.</p></div></section></main></Site>