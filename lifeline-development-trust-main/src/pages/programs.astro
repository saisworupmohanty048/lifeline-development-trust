---
import Site from '../layouts/Site.astro';
import {BookOpen,HeartPulse,HandHeart,House,Wrench,Users,Leaf} from 'lucide-react';
const programs=[{id:'education',title:'Education and Literacy Development',icon:BookOpen,text:'Opening pathways to learning through literacy, educational resources and inclusive access.',detail:'The deed sets out the promotion of education and the establishment of schools, libraries and educational institutions. Specific delivery locations, schedules and participation details will be shared when confirmed.',image:'https://images.pexels.com/photos/35558791/pexels-photo-35558791.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940',alt:'Illustrative photograph of children studying at a village school in India'},{id:'healthcare',title:'Healthcare and Medical Awareness',icon:HeartPulse,text:'Promoting informed health choices and a compassionate approach to medical relief.',detail:'The charitable objectives include medical relief, hospitals and health awareness programs. No conducted health camps, medical partnerships or patient outcomes have yet been verified for publication.',image:'',alt:''},{id:'community',title:'Poverty Relief and Community Support',icon:HandHeart,text:'Supporting the dignity and wellbeing of people facing economic hardship.',detail:'This objective focuses on relief to people experiencing poverty and practical community support. Future initiatives will be documented with confirmed details rather than estimates of reach.',image:'https://images.pexels.com/photos/30073700/pexels-photo-30073700.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940',alt:'Illustrative photograph of children outdoors in Maharashtra, India'},{id:'food',title:'Food and Shelter Assistance',icon:House,text:'Recognizing nourishment and safe shelter as foundations of human dignity.',detail:'Food and shelter assistance is included in the supplied deed as a charitable objective. No distributions, accommodation facilities or beneficiary counts are claimed on this website.',image:'',alt:''},{id:'skills',title:'Vocational Training and Skill Development',icon:Wrench,text:'Creating possibilities for practical learning, livelihoods and greater independence.',detail:'The deed includes vocational training within relief to people facing hardship. Courses, trainers, dates, admission criteria and certification arrangements will be announced only when confirmed.',image:'',alt:''},{id:'culture',title:'Social Welfare and Cultural Activities',icon:Users,text:'Strengthening belonging, inclusion and the cultural life of our communities.',detail:'Social welfare and cultural activities are stated objectives. The organization-supplied greeting in the gallery represents community communication, not verification of an organized event.',image:'',alt:''},{id:'environment',title:'Environmental Protection',icon:Leaf,text:'Encouraging care for local surroundings and a healthier shared environment.',detail:'Environmental protection is a stated charitable objective. No plantation totals, clean-up drives or conservation outcomes are reported without verified activity records.',image:'',alt:''}];
---
<Site title="Our Programs & Objectives | Lifeline Development Trust" description="Explore Lifeline Development Trust’s charitable objectives in education, health, community support, skills and environmental care."><main><section class="page-top"><div class="wrap"><p class="breadcrumbs"><a href="/">Home</a> / Our Programs</p><p class="eyebrow">A CONNECTED VISION FOR CHANGE</p><h1>Different needs.<br/>One shared humanity.</h1><p class="lead">LIFELINE DEVELOPMENT TRUST’s charitable objectives look at the whole person — learning, health, dignity, opportunity and the environment.</p></div></section><section class="wrap section"><div class="note-box"><strong>Our objectives, clearly stated.</strong> The areas below come from the supplied trust deed. They are planned charitable objectives, not claims of completed activities. All stock photography is illustrative; verified activity reports will be published separately.</div><div class="program-grid">{programs.map(p=><article id={p.id} class="program-card">{p.image?<img src={p.image} alt={p.alt} width="940" height="650" loading="lazy"/>:<div class="program-illustration" aria-hidden="true"><p.icon size={70} strokeWidth={1}/></div>}<div class="program-body"><span class="status">Planned charitable objective</span><span class="program-symbol"><p.icon size={22}/></span><h2>{p.title}</h2><p>{p.text}</p><details><summary>Learn More</summary><p>{p.detail}</p><a class="text-link" href="/contact">Enquire about this objective ↗</a></details><p class="photo-label">{p.image?'Illustrative stock photograph · Not a Trust activity':'Illustrative symbol · Activity photographs not yet available'}</p></div></article>)}</div></section><section class="cta-section"><div class="wrap cta-inner"><div><p class="eyebrow">BRING YOUR COMMITMENT</p><h2>Be part of the possibility.</h2><p>Share your interests, skills or partnership ideas with the Trust.</p></div><a class="button gold" href="/contact#volunteer">Become a Volunteer ↗</a></div></section></main></Site>